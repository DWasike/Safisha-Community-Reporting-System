<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.safisha.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.safisha.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register" />

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.safisha.ui.auth.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">
        <action
            android:id="@+id/action_dashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_dashboardFragment_to_reportIssueFragment"
            app:destination="@id/reportIssueFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_reportsPlaceholderFragment"
            app:destination="@id/reportsPlaceholderFragment" />
    </fragment>

    <fragment
        android:id="@+id/reportIssueFragment"
        android:name="com.example.safisha.ui.auth.ReportIssueFragment"
        android:label="Report a problem"
        tools:layout="@layout/fragment_report_issue" />

    <!-- Temporary: replace with Member 4's list fragment once merged -->
    <fragment
        android:id="@+id/reportsPlaceholderFragment"
        android:name="com.example.safisha.ui.auth.ReportsPlaceholderFragment"
        android:label="Reports">
        <argument
            android:name="showAll"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>

</navigation>